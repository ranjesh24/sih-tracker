# ml-pipeline environment. Copy to .env and fill in.
#
# Names and placeholders only. Never commit a real key (rules.md section 8).
# Every value here is read by src/config.py; no threshold is hardcoded
# anywhere else in the codebase.

# --- Backend connection ------------------------------------------------------
BACKEND_BASE_URL=http://localhost:8000
# Must match the backend's INGEST_API_KEY. Sent as the X-Ingest-Key header.
INGEST_API_KEY=replace-with-shared-ingest-key

# --- Runtime -----------------------------------------------------------------
# cuda | cpu | mps. Validated at startup; an unavailable device fails there
# rather than on frame 400.
DEVICE=cuda
MODELS_DIR_PATH=./models

# --- Video decode ------------------------------------------------------------
# Nominal playback rate. Timestamps derive from the true frame index and this
# value, never from wall-clock time at decode.
PLAYBACK_FPS=15.0
# Process every Nth frame. 1 = every frame. Skipping does NOT alter the
# timestamp of the frames that are kept: the true frame index still drives it.
FRAME_STRIDE=2

# --- Detection (YOLOv8s) -----------------------------------------------------
YOLO_MODEL_PATH=./models/yolov8s.pt
DETECTION_CONF_MIN=0.35
DETECTION_IOU_MAX=0.50
# COCO class ids: 2 car, 3 motorcycle, 5 bus, 7 truck.
TARGET_CLASS_IDS_CSV=2,3,5,7

# --- Tracking (ByteTrack) ----------------------------------------------------
BYTETRACK_TRACK_CONF_MIN=0.50
BYTETRACK_MATCH_IOU_MIN=0.80
BYTETRACK_BUFFER_FRAMES=30
# Frames a track id may be absent before its tracklet is finalised.
TRACK_LOST_FRAMES=30
# Finalised tracklets with fewer samples than this are discarded as noise.
TRACKLET_MIN_FRAMES=8

# --- Best-shot selection -----------------------------------------------------
# How many top-scoring frames survive tier-1 buffering into tier-2 work.
BEST_SHOT_TOP_K=5
BEST_SHOT_MIN_AREA_PX=2500

# --- Re-ID (OSNet x1.0) ------------------------------------------------------
REID_MODEL_NAME=osnet_x1_0
# 256x256, amended TASK-000: 256x128 is a person aspect ratio; vehicles are wide.
REID_INPUT_HEIGHT_PX=256
REID_INPUT_WIDTH_PX=256
REID_BATCH_SIZE=16
REID_EMBEDDING_DIM=512

# --- Plate OCR (EasyOCR) -----------------------------------------------------
OCR_MIN_CONFIDENCE=0.40
# Lower fraction of the vehicle box searched for a plate. Keeps OCR away from
# badge text and background signage, the source of most junk reads.
PLATE_ROI_FRACTION=0.40
# Plate crops are far below EasyOCR's expected resolution; upscale before reading.
PLATE_UPSCALE_FACTOR=4
# Ceiling on the upscaled ROI width. Caps OCR cost on frame-filling vehicles;
# small distant plates never reach it and still upscale by the full factor.
PLATE_ROI_MAX_WIDTH_PX=640
# How many best shots get an OCR pass. The embedder still uses BEST_SHOT_TOP_K.
PLATE_OCR_TOP_K=3

# --- Ingest client -----------------------------------------------------------
INGEST_TIMEOUT_SECONDS=10.0
INGEST_MAX_RETRIES=3
INGEST_BACKOFF_BASE_SECONDS=0.5

# --- Visualisation -----------------------------------------------------------
VISUALIZE_OUTPUT_FPS=15.0

# --- Storage -----------------------------------------------------------------
CROP_STORAGE_PATH=./data/crops
